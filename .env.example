# ========================================================
# PROVEEDORES LLM (configura al menos uno)
# ========================================================

# ---- Groq ----
# Obtén tu key gratis en: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq_aqui
LLM_MODEL=openai/gpt-oss-120b

# ---- Google Gemini ----
# Obtén tu key gratis en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-flash-latest

# Provider por defecto al arrancar: "groq" o "gemini"
DEFAULT_PROVIDER=groq

# ========================================================
# Parámetros LLM compartidos
# ========================================================
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600

# ========================================================
# Modelo de Embeddings
# ========================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ========================================================
# Chunking
# ========================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=50

# ========================================================
# Retrieval
# ========================================================
TOP_K=5

# ========================================================
# Storage
# ========================================================
VECTORSTORE_PATH=./vectorstore/index.pkl
DOCS_PATH=./documentos